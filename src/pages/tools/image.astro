---
import Base from '../../layouts/Base.astro';
---

<Base title="图片工具箱 · 压缩 / 改尺寸 / 转格式" description="浏览器本地图片处理：压缩、改尺寸、转格式，不上传不留存。">
<div class="wrap">
  <header class="top">
    <a class="logo" href={`${import.meta.env.BASE_URL}/tools/`}>kirin<b>.dev</b>/tools</a>
    <a class="back" href={`${import.meta.env.BASE_URL}/tools/`}>← 返回工具箱</a>
  </header>

  <h1>🖼️ 图片工具箱</h1>
  <p class="sub"><span class="tag">本地处理</span><span class="tag">不上传</span><span class="tag">免费</span>压缩大小 · 修改宽高 · 转换格式，全部在你的浏览器内完成，图片不会离开设备。</p>

  <div id="drop">
    <div class="icon">📁</div>
    <p>拖拽图片到这里，或 <b>点击选择</b>（支持多选 / Ctrl+V 粘贴）</p>
  </div>
  <input type="file" id="fileInput" accept="image/*" multiple />

  <div class="panel">
    <div class="card">
      <h3><span class="n">1</span>压缩质量</h3>
      <div class="row">
        <label>质量</label>
        <input type="range" id="quality" min="10" max="100" value="80" />
        <span class="qval" id="qval">80%</span>
      </div>
      <p class="hint">数值越低体积越小。PNG 无损格式转出时质量项不生效，建议选 JPG/WebP 压缩。</p>
      <h3 style="margin-top:18px"><span class="n">3</span>输出格式</h3>
      <div class="row">
        <div class="seg" id="fmtSeg">
          <button data-f="keep" class="on">保持原格式</button>
          <button data-f="image/jpeg">JPG</button>
          <button data-f="image/png">PNG</button>
          <button data-f="image/webp">WebP</button>
        </div>
      </div>
    </div>
    <div class="card">
      <h3><span class="n">2</span>修改尺寸（宽 × 高）</h3>
      <div class="row">
        <label>宽</label><input type="number" class="num" id="w" min="1" placeholder="原始" />
        <label style="min-width:auto">高</label><input type="number" class="num" id="h" min="1" placeholder="原始" />
      </div>
      <div class="row">
        <label class="chk"><input type="checkbox" id="lock" checked />锁定比例</label>
        <label class="chk"><input type="checkbox" id="percent" />按百分比</label>
      </div>
      <div class="row" id="pctRow" style="display:none">
        <label>比例</label><input type="number" class="num" id="pct" value="50" min="1" max="500" /><span style="font-size:.9rem;color:var(--dim)">%</span>
      </div>
      <p class="hint">留空 = 保持原始尺寸。锁定比例时填宽自动算高（反之亦然）。</p>
    </div>
  </div>

  <div class="actions">
    <button class="btn btn-primary" id="go" disabled>🚀 开始处理</button>
    <button class="btn btn-ghost" id="clear" disabled>清空列表</button>
    <button class="btn btn-ghost" id="dlAll" style="display:none">📦 全部下载</button>
  </div>

  <p class="empty-tip" id="emptyTip">还没有处理结果</p>
  <div id="results"></div>
  <div class="summary" id="summary"></div>

  <footer>// processed locally in your browser · built by Kirin</footer>
</div>
</Base>

<style is:global>

:root{
  --bg:#f8fafc; --bg-soft:#eef4ff; --card:#fff; --text:#1e293b; --dim:#64748b;
  --accent:#2563eb; --accent-soft:#eff6ff; --line:#e2e8f0; --ok:#16a34a; --warn:#dc2626;
  --mono:ui-monospace,'SF Mono',Menlo,Consolas,monospace;
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:system-ui,-apple-system,'PingFang SC','Microsoft YaHei',sans-serif;background:var(--bg);color:var(--text);min-height:100vh}
body::before{content:'';position:fixed;top:-160px;left:-160px;width:480px;height:480px;border-radius:50%;
  background:radial-gradient(circle,rgba(37,99,235,.10),transparent 70%);pointer-events:none}
.wrap{max-width:1080px;margin:0 auto;padding:24px 16px 80px}
header.top{display:flex;align-items:center;justify-content:space-between;margin-bottom:28px}
.logo{font-family:var(--mono);font-weight:700;font-size:1.1rem;text-decoration:none;color:var(--text)}
.logo b{color:var(--accent)}
.back{font-size:.85rem;color:var(--dim);text-decoration:none}
.back:hover{color:var(--accent)}
h1{font-size:1.6rem;margin-bottom:6px}
.sub{color:var(--dim);font-size:.9rem;margin-bottom:24px}
.sub .tag{display:inline-block;background:var(--accent-soft);color:var(--accent);font-size:.72rem;padding:2px 10px;border-radius:99px;margin-right:6px;font-family:var(--mono)}

/* 上传区 */
#drop{border:2px dashed var(--line);border-radius:16px;background:var(--card);padding:52px 20px;text-align:center;cursor:pointer;transition:border-color .2s,background .2s}
#drop:hover,#drop.over{border-color:var(--accent);background:var(--accent-soft)}
#drop .icon{font-size:2.4rem}
#drop p{color:var(--dim);font-size:.92rem;margin-top:10px}
#drop b{color:var(--accent)}
#fileInput{display:none}

/* 设置面板 */
.panel{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:20px}
@media(max-width:760px){.panel{grid-template-columns:1fr}}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:20px}
.card h3{font-size:.95rem;margin-bottom:14px;display:flex;align-items:center;gap:8px}
.card h3 .n{font-family:var(--mono);font-size:.72rem;color:var(--accent);background:var(--accent-soft);border-radius:6px;padding:2px 7px}
.row{display:flex;align-items:center;gap:12px;margin-bottom:12px;flex-wrap:wrap}
.row label{font-size:.85rem;color:var(--dim);min-width:64px}
input[type=range]{flex:1;accent-color:var(--accent);min-width:140px}
.qval{font-family:var(--mono);font-size:.85rem;color:var(--accent);min-width:44px;text-align:right}
.seg{display:flex;border:1px solid var(--line);border-radius:10px;overflow:hidden}
.seg button{border:0;background:transparent;padding:8px 16px;font-size:.85rem;cursor:pointer;color:var(--dim)}
.seg button.on{background:var(--accent);color:#fff}
.num{width:90px;padding:8px 10px;border:1px solid var(--line);border-radius:8px;font-size:.9rem}
.num:focus{outline:2px solid var(--accent-soft);border-color:var(--accent)}
.hint{font-size:.78rem;color:var(--dim);margin-top:4px}
.chk{display:flex;align-items:center;gap:6px;font-size:.85rem;color:var(--text);cursor:pointer}
.chk input{accent-color:var(--accent);width:16px;height:16px}

/* 操作条 */
.actions{display:flex;gap:12px;margin-top:20px;flex-wrap:wrap}
.btn{border:0;border-radius:10px;padding:12px 26px;font-size:.95rem;cursor:pointer;font-weight:600}
.btn-primary{background:var(--accent);color:#fff}
.btn-primary:hover{background:#1d4ed8}
.btn-ghost{background:var(--card);color:var(--text);border:1px solid var(--line)}
.btn:disabled{opacity:.5;cursor:not-allowed}
#pick{display:none}

/* 结果列表 */
#results{margin-top:20px;display:flex;flex-direction:column;gap:12px}
.item{display:flex;gap:14px;background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px;align-items:center}
.item img{width:72px;height:72px;object-fit:cover;border-radius:8px;border:1px solid var(--line);background:#f1f5f9;flex-shrink:0}
.meta{flex:1;min-width:0}
.meta .name{font-size:.9rem;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.meta .stat{font-family:var(--mono);font-size:.78rem;color:var(--dim);margin-top:4px}
.meta .stat b{color:var(--ok)}
.meta .stat b.bad{color:var(--warn)}
.item .dl{background:var(--accent);color:#fff;border:0;border-radius:8px;padding:9px 18px;font-size:.85rem;cursor:pointer;text-decoration:none;display:inline-block}
.item .dl:hover{background:#1d4ed8}
.bar{height:6px;border-radius:99px;background:var(--line);margin-top:8px;overflow:hidden}
.bar i{display:block;height:100%;background:var(--ok);border-radius:99px}
.bar i.bad{background:var(--warn)}
.summary{margin-top:16px;background:var(--accent-soft);border:1px solid rgba(37,99,235,.25);border-radius:12px;padding:14px 18px;font-size:.9rem;display:none}
.summary b{color:var(--accent);font-family:var(--mono)}
.empty-tip{text-align:center;color:var(--dim);font-size:.85rem;padding:30px 0;display:none}
footer{margin-top:48px;text-align:center;color:var(--dim);font-size:.8rem;font-family:var(--mono)}
</style>

<script>

const $=id=>document.getElementById(id);
let files=[],fmt='keep';

$('drop').onclick=()=>$('fileInput').click();
$('fileInput').onchange=e=>addFiles([...e.target.files]);
['dragover','dragleave','drop'].forEach(ev=>{
  $('drop').addEventListener(ev,e=>{e.preventDefault();
    $('drop').classList.toggle('over',ev==='dragover');
    if(ev==='drop')addFiles([...e.dataTransfer.files]);
  });
});
document.addEventListener('paste',e=>{
  const items=[...(e.clipboardData?.items||[])].filter(i=>i.type.startsWith('image/'));
  if(items.length)addFiles(items.map(i=>i.getAsFile()).filter(Boolean));
});
window.addEventListener('dragover',e=>e.preventDefault());
window.addEventListener('drop',e=>e.preventDefault());

function addFiles(list){
  const imgs=list.filter(f=>f.type.startsWith('image/'));
  if(!imgs.length)return;
  files=[...files,...imgs];
  $('go').disabled=false;$('clear').disabled=false;
  $('drop').querySelector('p').innerHTML=`已选择 <b>${files.length}</b> 张图片，点击可继续添加`;
}

$('quality').oninput=e=>$('qval').textContent=e.target.value+'%';
$('percent').onchange=e=>$('pctRow').style.display=e.target.checked?'flex':'none';

$('fmtSeg').addEventListener('click',e=>{
  const b=e.target.closest('button');if(!b)return;
  fmt=b.dataset.f;
  $('fmtSeg').querySelectorAll('button').forEach(x=>x.classList.toggle('on',x===b));
});

// 尺寸联动
$('w').oninput=()=>{if($('lock').checked&&$('w').value)fillRatio('w')};
$('h').oninput=()=>{if($('lock').checked&&$('h').value)fillRatio('h')};
function fillRatio(src){
  const els={w:$('w'),h:$('h')},other=src==='w'?'h':'w';
  if(!els[other].dataset.ratio)els[other].dataset.ratio=els[other].value||null;
  const r=parseFloat(els[src].value);
  if(!r||isNaN(r))return;
  const base=parseFloat(els[other].dataset.ratio);
  if(base)els[other].value=Math.round(r/base*100)/100;
}

$('clear').onclick=()=>{files=[];$('results').innerHTML='';$('summary').style.display='none';
  $('go').disabled=true;$('clear').disabled=true;$('dlAll').style.display='none';$('emptyTip').style.display='none';
  $('fileInput').value='';$('drop').querySelector('p').innerHTML='拖拽图片到这里，或 <b>点击选择</b>（支持多选 / Ctrl+V 粘贴）';};

$('go').onclick=async()=>{
  if(!files.length)return;
  $('go').disabled=true;$('go').textContent='处理中…';
  $('results').innerHTML='';$('emptyTip').style.display='none';
  let done=0,inB=0,outB=0;
  const outs=[];
  for(const f of files){
    try{const r=await process(f);inB+=r.inSize;outB+=r.outSize;outs.push(r);done++;}
    catch(err){console.error(err);alert('处理失败：'+f.name);}
  }
  $('go').disabled=false;$('go').textContent='🚀 开始处理';
  if(done){
    $('dlAll').style.display='inline-block';$('dlAll')._files=outs;
    const s=$('summary');s.style.display='block';
    const diff=inB-outB,pc=inB?Math.round(diff/inB*100):0;
    s.innerHTML=`共处理 <b>${done}</b> 张：${fmtB(inB)} → <b>${fmtB(outB)}</b>，`+
      (diff>=0?`节省 <b>${fmtB(diff)}</b>（-${pc}%）`:`增大 <b>${fmtB(-diff)}</b>（+${-pc}%，可调低质量或选 WebP）`);
  }
};

function fmtB(n){return n>1048576?(n/1048576).toFixed(2)+' MB':n>1024?(n/1024).toFixed(1)+' KB':n+' B'}

function targetSize(w,h){
  const iw=w,ih=h;
  if($('percent').checked){
    const p=parseFloat($('pct').value)/100||1;
    return [Math.max(1,Math.round(iw*p)),Math.max(1,Math.round(ih*p))];
  }
  let tw=parseFloat($('w').value),th=parseFloat($('h').value);
  if(!tw&&!th)return[iw,ih];
  if($('lock').checked){
    const r=ih/iw;
    if(tw&&!th)th=Math.round(tw*r);
    if(th&&!tw)tw=Math.round(th/r);
    if(tw&&th)return[tw,th]; // 两个都填了，尊重输入
  }
  return[Math.max(1,Math.round(tw||iw)),Math.max(1,Math.round(th||ih))];
}

function extOf(t){return t==='image/jpeg'?'jpg':t==='image/png'?'png':t==='image/webp'?'webp':t==='image/gif'?'gif':'img'}

function process(file){
  return new Promise((res,rej)=>{
    const img=new Image();
    const url=URL.createObjectURL(file);
    img.onload=()=>{
      const [tw,th]=targetSize(img.naturalWidth,img.naturalHeight);
      const c=document.createElement('canvas');
      c.width=tw;c.height=th;
      const ctx=c.getContext('2d');
      // PNG/GIF 转 JPG 时铺白底避免黑底
      const outType=fmt==='keep'?file.type:fmt;
      if(outType==='image/jpeg'){ctx.fillStyle='#fff';ctx.fillRect(0,0,tw,th);}
      ctx.imageSmoothingQuality='high';
      ctx.drawImage(img,0,0,tw,th);
      const q=parseInt($('quality').value)/100;
      const finalType=(outType==='image/gif')?'image/png':outType;
      c.toBlob(blob=>{
        URL.revokeObjectURL(url);
        if(!blob)return rej(new Error('encode failed'));
        const ext=extOf(finalType);
        const base=file.name.replace(/\.[^.]+$/,'');
        const name=`${base}_${tw}x${th}${fmt!=='keep'?'.'+ext:''}.${ext}`;
        const u=URL.createObjectURL(blob);
        show(file,blob,u,name,tw,th);
        res({name,blob,inSize:file.size,outSize:blob.size,url:u});
      },finalType,q);
    };
    img.onerror=()=>{URL.revokeObjectURL(url);rej(new Error('decode failed'))};
    img.src=url;
  });
}

function show(src,blob,url,name,tw,th){
  const item=document.createElement('div');item.className='item';
  const saved=src.size-blob.size,pc=src.size?Math.round(saved/src.size*100):0;
  item.innerHTML=`
    <img src="${url}" alt="" />
    <div class="meta">
      <div class="name" title="${name}">${name}</div>
      <div class="stat">${src.naturalWidth||''}${tw}×${th} · ${fmtB(src.size)} → <b class="${saved<0?'bad':''}">${fmtB(blob.size)}</b>（${saved>=0?'-'+pc+'%':'+'+(-pc)+'%'}）</div>
      <div class="bar"><i class="${saved<0?'bad':''}" style="width:${Math.max(2,100-Math.max(0,pc))}%"></i></div>
    </div>
    <a class="dl" href="${url}" download="${name}">下载</a>`;
  $('results').appendChild(item);
}

$('dlAll').onclick=async e=>{
  const outs=e.target._files||[];
  for(const o of outs){
    await new Promise(r=>{const a=document.createElement('a');a.href=o.url;a.download=o.name;a.click();setTimeout(r,350)});
  }
};

</script>
